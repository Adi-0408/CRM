rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'platform_super_admin' ||
        request.auth.token.email == 'superadmin@crm.com'
      );
    }
    
    function isTenantUser(companyId) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.company_id == companyId
      );
    }

    // Companies: readable by authenticated users; writable by super admin or company admin
    match /companies/{companyId} {
      allow read: if isAuthenticated();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || isTenantUser(companyId);
    }

    // Default multi-tenant collections:
    // Requires authentication and data must belong to the caller's tenant
    match /{collectionName}/{docId} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        resource == null ||
        resource.data.company_id == null ||
        resource.data.company_id == request.auth.token.company_id
      );
      
      allow create: if isAuthenticated() && (
        isSuperAdmin() ||
        request.resource.data.company_id == request.auth.token.company_id
      );
      
      allow update, delete: if isAuthenticated() && (
        isSuperAdmin() ||
        (resource.data.company_id == request.auth.token.company_id &&
         (request.resource == null || request.resource.data.company_id == resource.data.company_id))
      );
    }
  }
}
